# 破晓 .gitignore

# 运行时数据 / 扫描产物（内部，不入库）
data/
scan_results/
recon_report.json
*_reports/

# 内部工程上下文（不入库）
CONTEXT.md
AGENTS.md
docs/agents/
docs/requirements.md

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
*.egg

# 虚拟环境
.venv/
venv/
env/

# IDE
.vscode/
.idea/
*.swp
*.swo

# 临时文件
temp_*.txt
*.tmp
*.log
# 提交脚本临时文件（_msg.txt / _cm.txt 等，曾被误提交）
_*.txt

# 测试/构建产物
.coverage
.coverage.*
htmlcov/
dist/
build/
*.egg-info/

# 操作系统
.DS_Store
Thumbs.db

# 敏感信息
.env
*.key
*.pem
cookies.json
storage_state.json
