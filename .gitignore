# 破晓 .gitignore

# 运行时数据
scan_results/*.db
scan_results/*.json
scan_results/*.md
scan_results/src_reports/
scan_results/rayscan/

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
*.egg

# 虚拟环境
.venv/
venv/
env/

# IDE
.vscode/
.idea/
*.swp
*.swo

# 临时文件
temp_*.txt
*.tmp
*.log

# 操作系统
.DS_Store
Thumbs.db

# 敏感信息
.env
*.key
*.pem
cookies.json
storage_state.json
